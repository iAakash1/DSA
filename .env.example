# ---------------------------------------------------------------------------
# CP-FORGE — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

APP_ENV=development
APP_URL=http://localhost:5173
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# CP-Forge runs on PostgreSQL (Supabase). Copy the connection string from
# Supabase > Project Settings > Database > Connection string > URI.
#
# Use the SESSION POOLER (port 5432) for FastAPI: it is IPv4-reachable and
# holds a session per connection, which SQLAlchemy's pool expects. The
# transaction pooler (6543) does not support prepared statements and will
# break psycopg. The scheme is upgraded to +psycopg automatically.
#
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# SQLite is supported for the test suite and offline development ONLY, and
# must be opted into explicitly with ALLOW_SQLITE=true.
DATABASE_URL=
ALLOW_SQLITE=false

# ---------------------------------------------------------------------------
# SUPABASE
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 projects: Project Settings → API → JWT Secret.
# Newer projects sign with RS256/ECC and are verified via JWKS automatically.
SUPABASE_JWT_SECRET=

# `local`     -> single-user dev mode, no Supabase required (default)
# `supabase`  -> verify Supabase Auth JWTs on every request
# local  = deterministic dev identity, no provider needed
# clerk  = Clerk verifies the session (production)
# supabase = legacy Supabase Auth JWTs
AUTH_MODE=local

# ---------------------------------------------------------------------------
# AI — GROQ
# ---------------------------------------------------------------------------
# Leave GROQ_API_KEY empty to run CP-Forge fully without AI. Every deterministic
# feature keeps working; only the AI Coach surfaces are disabled.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model routing. Groq production models; Llama 3.x avoided (decommissioning).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_STRONG=openai/gpt-oss-120b

AI_ENABLED=true
AI_REQUESTS_PER_DAY=50
AI_REQUESTS_PER_MINUTE=5
AI_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# PLATFORM ACCOUNTS (optional bootstrap defaults)
# ---------------------------------------------------------------------------
CODEFORCES_HANDLE=
LEETCODE_USERNAME=


# ---------------------------------------------------------------------------
# EDITORIAL / VIDEO (YouTube Data API v3) — optional
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
# Comma-separated trusted channel IDs. Defaults cover takeUforward + TLE Eliminators.
YOUTUBE_TRUSTED_CHANNELS=

# ---------------------------------------------------------------------------
# BACKGROUND JOBS
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=false (most of the times)
SYNC_INTERVAL_MINUTES=180

# ---------------------------------------------------------------------------
# CLERK AUTHENTICATION
# ---------------------------------------------------------------------------
# Browser-safe. Vite inlines every VITE_-prefixed value into the bundle, so
# nothing secret may ever carry this prefix.
VITE_CLERK_PUBLISHABLE_KEY=

# Where the browser reaches the API.
# Leave EMPTY for local development: Vite's dev proxy forwards /api to the
# local backend, so there is no CORS and no origin to configure.
# REQUIRED in production, because Vercel serves static files with no proxy —
# without it every request 404s against the static host. Include the /api path.
#   e.g. https://cp-forge-api.onrender.com/api
VITE_API_BASE_URL=
CLERK_SECRET_KEY=
# Optional: origins that cannot be listed up front. Vercel gives every preview
# deployment its own hostname, so allowing them needs a pattern rather than a
# list. Leave empty unless you actually want previews to reach production data.
#   e.g. https://cpdsa-[a-z0-9-]+\.vercel\.app
CORS_ORIGIN_REGEX=
